#==============================================================================================
#
#   zstd/vectors - Reference and golden frames (generated tests)
#
#   DESCRIPTION:
#       Generated by tools/zstd_vectors.py; do not edit. The zstd repository's golden
#       decompression files, and frames from the zstd CLI (v1.5.7) over deterministic
#       inputs. Each decodes to the output's length and CRC-32, or fails as corrupt (the
#       frame is held as little-endian 64-bit words).
#
#==============================================================================================

test "golden empty-block.zst":
    let frame: u64[2] = [
        0x00150000fd2fb528, 0x0000000000000000,
    ]
    try check_vector(u8[]((u8*)&frame[0], 11), 0, 0)

test "golden rle-first-block.zst":
    let frame: u64[6] = [
        0x100000a4fd2fb528, 0x1000020010000200, 0x1000020010000200, 0x1000020010000200, 0x1000030010000200, 0x000000e1163ef100,
    ]
    try check_vector(u8[]((u8*)&frame[0], 45), 1048576, 2805525020)

test "golden zeroSeq_2B.zst":
    let frame: u64[4] = [
        0x00850000fd2fb528, 0x206f6c6c65486800, 0x800a21646c726f57, 0x0000000000000000,
    ]
    try check_vector(u8[]((u8*)&frame[0], 25), 13, 2098519517)

test "golden error off0.bin.zst":
    let frame: u64[3] = [
        0x00450000fd2fb528, 0x0b432f0002000800, 0x00000000000000ae,
    ]
    assert(failure_of(u8[]((u8*)&frame[0], 17)) == corrupt)

test "golden error truncated_huff_state.zst":
    let frame: u64[3] = [
        0x00550000fd2fb528, 0x1f7e200401807200, 0x000000000000aa02,
    ]
    assert(failure_of(u8[]((u8*)&frame[0], 19)) == corrupt)

test "golden error zeroSeq_extraneous.zst":
    let frame: u64[4] = [
        0x00950000fd2fb528, 0x206f6c6c65486800, 0x800a21646c726f57, 0x0000000000000000,
    ]
    assert(failure_of(u8[]((u8*)&frame[0], 27)) == corrupt)

